rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Primitive Helpers (Pillar 3)
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && !exists(/databases/$(database)/documents/account_deletion_jobs/$(request.auth.uid));
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedSuperAdmin() {
      return isVerified() && request.auth.token.email == 'haw33inc@gmail.com';
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // userRole is authoritative. Display fields and legacy flags never grant access.
    function hasRole(data, roles) {
      return data.get('userRole', 'user') in roles;
    }

    function isActiveUser() {
      return isVerified() && userDocExists() &&
        callerDoc().get('isActive', true) == true &&
        callerDoc().get('isApproved', true) == true &&
        callerDoc().get('approvalStatus', 'approved') == 'approved';
    }

    function isSuperAdmin() {
      return isActiveUser() && hasRole(callerDoc(), ['super_admin', 'superAdmin', 'superadmin']);
    }

    function isAdmin() {
      return isActiveUser() && hasRole(callerDoc(), ['super_admin', 'superAdmin', 'superadmin', 'admin']);
    }

    function isUnionMaum() {
      return isActiveUser() && hasRole(callerDoc(), ['union_maum', 'unionMAUM', 'unionmaum']);
    }

    function isMissionAdmin() {
      return isActiveUser() && hasRole(callerDoc(), ['super_admin', 'superAdmin', 'superadmin', 'admin', 'union_maum', 'unionMAUM', 'unionmaum', 'mission_admin', 'missionAdmin', 'missionPresident']);
    }

    function callerMissionId() {
      return callerDoc().get('missionId', callerDoc().get('mission', ''));
    }

    function callerDistrictId() {
      return callerDoc().get('districtId', callerDoc().get('district', ''));
    }

    function isMissionAdminFor(missionId) {
      return isAdmin() || isUnionMaum() || (
        isActiveUser() && hasRole(callerDoc(), ['mission_admin', 'missionAdmin', 'missionPresident']) &&
        missionId is string && missionId.size() > 0 && callerMissionId() == missionId
      );
    }

    function isMissionLeadershipFor(missionId) {
      return isAdmin() || isUnionMaum() || (
        isActiveUser() &&
        hasRole(callerDoc(), ['mission_admin', 'missionAdmin', 'missionPresident', 'ministerial_secretary', 'ministerialSecretary', 'director', 'officer']) &&
        missionId is string && missionId.size() > 0 && callerMissionId() == missionId
      );
    }

    function isDistrictPastorFor(districtId) {
      return isActiveUser() && (
        (hasRole(callerDoc(), ['district_pastor', 'districtPastor']) && callerDistrictId() == districtId) ||
        (exists(/databases/$(database)/documents/districts/$(districtId)) &&
         get(/databases/$(database)/documents/districts/$(districtId)).data.get('districtPastorId', '') == request.auth.uid)
      );
    }

    function isChurchTreasurerFor(churchId) {
      return isActiveUser() && (
        (hasRole(callerDoc(), ['church_treasurer', 'churchTreasurer']) && callerDoc().get('churchId', '') == churchId) ||
        (exists(/databases/$(database)/documents/churches/$(churchId)) &&
         get(/databases/$(database)/documents/churches/$(churchId)).data.get('treasurerId', '') == request.auth.uid)
      );
    }

    function isEditorInMission(missionId) {
      return isMissionAdminFor(missionId) || (
        isActiveUser() && hasRole(callerDoc(), ['editor']) &&
        missionId is string && missionId.size() > 0 && callerMissionId() == missionId
      );
    }

    function userMission(data) {
      return data.get('missionId', data.get('mission', ''));
    }

    function canManageUser(data) {
      return isAdmin() || isMissionAdminFor(userMission(data));
    }

    function canUpdateUser(userId, oldData, newData) {
      let changed = newData.diff(oldData).affectedKeys();
      let actorRole = callerDoc().get('userRole', 'user');
      let oldRole = oldData.get('userRole', 'user');
      let newRole = newData.get('userRole', 'user');
      let globalRoles = ['super_admin', 'superAdmin', 'superadmin', 'admin'];
      let missionRoles = ['mission_admin', 'missionAdmin', 'missionPresident'];
      return (
        request.auth.uid == userId && (
          changed.hasOnly(['displayName', 'photoURL', 'phone', 'onboardingCompleted', 'updatedAt']) || (
            isActiveUser() && oldRole == 'user' && oldData.get('onboardingCompleted', false) == false &&
            changed.hasOnly([
              'displayName', 'photoURL', 'phone', 'unionId', 'unionName',
              'missionId', 'mission', 'missionName', 'regionId', 'region', 'regionName',
              'districtId', 'district', 'districtName', 'churchId', 'churchName',
              'onboardingCompleted', 'updatedAt'
            ])
          )
        )
      ) || (
        isActiveUser() && (
          actorRole in ['super_admin', 'superAdmin', 'superadmin'] ||
          (actorRole == 'admin' && !(oldRole in globalRoles) && !(newRole in globalRoles)) ||
          (actorRole in missionRoles &&
           !(oldRole in globalRoles) && !(newRole in globalRoles) &&
           !(oldRole in missionRoles) && !(newRole in missionRoles) &&
           callerMissionId() != '' &&
           userMission(oldData) == callerMissionId() && userMission(newData) == callerMissionId())
        )
      );
    }

    function validOptStr(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function nullableOptStr(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function validOptBool(data, key) {
      return !(key in data) || (data[key] is bool);
    }

    function validOptInt(data, key, minVal, maxVal) {
      return !(key in data) || (data[key] is int && data[key] >= minVal && data[key] <= maxVal);
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Pillar 2)
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'userRole', 'onboardingCompleted']) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'phone', 'userRole', 'role', 'roleTitle',
          'isAdmin', 'isEditor', 'isMissionAdmin', 'isChurchTreasurer', 'level', 'unionId', 'unionName', 'missionId', 'mission', 'missionName',
          'regionId', 'region', 'regionName', 'districtId', 'district', 'districtName', 'churchId', 'churchName',
          'isPremium', 'isActive', 'isApproved', 'approvalStatus', 'approvedBy', 'approvalNote',
          'onboardingCompleted', 'createdAt', 'updatedAt'
        ]) &&
        (!('uid' in data) || isValidId(data.uid)) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        validOptStr(data, 'photoURL', 500) &&
        validOptStr(data, 'phone', 40) &&
        data.userRole in ['super_admin', 'superAdmin', 'admin', 'union_maum', 'unionMAUM', 'unionmaum', 'mission_admin', 'missionAdmin', 'missionPresident', 'ministerial_secretary', 'ministerialSecretary', 'director', 'officer', 'editor', 'district_pastor', 'districtPastor', 'church_treasurer', 'churchTreasurer', 'user'] &&
        validOptStr(data, 'role', 64) &&
        nullableOptStr(data, 'roleTitle', 80) &&
        validOptBool(data, 'isAdmin') &&
        validOptInt(data, 'level', 1, 5) &&
        validOptStr(data, 'unionId', 128) &&
        validOptStr(data, 'unionName', 120) &&
        validOptStr(data, 'missionId', 128) &&
        nullableOptStr(data, 'mission', 128) &&
        validOptStr(data, 'missionName', 120) &&
        validOptStr(data, 'regionId', 128) &&
        nullableOptStr(data, 'region', 128) &&
        validOptStr(data, 'regionName', 120) &&
        validOptStr(data, 'districtId', 128) &&
        nullableOptStr(data, 'district', 128) &&
        validOptStr(data, 'districtName', 120) &&
        nullableOptStr(data, 'churchId', 128) &&
        validOptStr(data, 'churchName', 120) &&
        validOptBool(data, 'isPremium') &&
        validOptBool(data, 'isActive') &&
        validOptBool(data, 'isApproved') &&
        (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected']) &&
        validOptStr(data, 'approvedBy', 128) &&
        validOptStr(data, 'approvalNote', 300) &&
        data.onboardingCompleted is bool &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidUnion(data) {
      return data.keys().hasAll(['name', 'code', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'code', 'country', 'headquarters', 'isActive', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 24 &&
        validOptStr(data, 'country', 80) &&
        validOptStr(data, 'headquarters', 200) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMission(data) {
      return data.keys().hasAll(['name', 'code', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['unionId', 'unionName', 'name', 'code', 'country', 'headquarters', 'isActive', 'createdAt', 'updatedAt']) &&
        validOptStr(data, 'unionId', 128) &&
        validOptStr(data, 'unionName', 120) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 24 &&
        validOptStr(data, 'country', 80) &&
        validOptStr(data, 'headquarters', 200) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMissionReportSummary(data) {
      return data.keys().hasAll(['missionId', 'title', 'period', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'title', 'period', 'createdBy', 'notes', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.period is string && data.period.size() >= 1 && data.period.size() <= 32 &&
        isValidId(data.createdBy) &&
        validOptStr(data, 'notes', 2000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRegion(data) {
      return data.keys().hasAll(['missionId', 'name', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'name', 'code', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        validOptStr(data, 'code', 24) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDistrict(data) {
      return data.keys().hasAll(['missionId', 'regionId', 'name', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'regionId', 'name', 'districtPastorId', 'districtPastorName', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        isValidId(data.regionId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        validOptStr(data, 'districtPastorId', 128) &&
        validOptStr(data, 'districtPastorName', 120) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChurch(data) {
      return data.keys().hasAll(['missionId', 'regionId', 'districtId', 'name', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'regionId', 'districtId', 'name', 'churchCode', 'treasurerId', 'treasurerName', 'memberCount', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        isValidId(data.regionId) &&
        isValidId(data.districtId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        validOptStr(data, 'churchCode', 32) &&
        validOptStr(data, 'treasurerId', 128) &&
        validOptStr(data, 'treasurerName', 120) &&
        validOptInt(data, 'memberCount', 0, 100000) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['missionId', 'fullName', 'position', 'status', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'mission', 'regionId', 'districtId', 'district', 'fullName', 'position', 'email', 'phone', 'status', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        validOptStr(data, 'mission', 128) &&
        validOptStr(data, 'regionId', 128) &&
        validOptStr(data, 'districtId', 128) &&
        validOptStr(data, 'district', 128) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.position is string && data.position.size() >= 1 && data.position.size() <= 80 &&
        validOptStr(data, 'email', 200) &&
        validOptStr(data, 'phone', 40) &&
        data.status in ['active', 'inactive', 'transferred'] &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['missionId', 'name', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'name', 'code', 'description', 'directorName', 'resourceUrl', 'secondaryUrl', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        validOptStr(data, 'code', 32) &&
        validOptStr(data, 'description', 600) &&
        validOptStr(data, 'directorName', 120) &&
        validOptStr(data, 'resourceUrl', 500) &&
        validOptStr(data, 'secondaryUrl', 500) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFinancialReport(data) {
      return data.keys().hasAll([
          'missionId', 'regionId', 'districtId', 'churchId', 'churchName',
          'submittedBy', 'year', 'month', 'tithe', 'combinedBudget',
          'missionOffering', 'localChurchOffering', 'specialOffering',
          'totalIncome', 'totalExpense', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'missionId', 'regionId', 'districtId', 'churchId', 'churchName',
          'submittedBy', 'submittedByName', 'year', 'month', 'tithe', 'combinedBudget',
          'missionOffering', 'localChurchOffering', 'specialOffering',
          'totalIncome', 'totalExpense', 'status', 'notes', 'famId', 'history',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.missionId) &&
        isValidId(data.regionId) &&
        isValidId(data.districtId) &&
        isValidId(data.churchId) &&
        data.churchName is string && data.churchName.size() >= 1 && data.churchName.size() <= 160 &&
        isValidId(data.submittedBy) &&
        validOptStr(data, 'submittedByName', 120) &&
        data.year is int && data.year >= 2000 && data.year <= 2100 &&
        data.month is int && data.month >= 1 && data.month <= 12 &&
        data.tithe is number && data.tithe >= 0 &&
        data.combinedBudget is number && data.combinedBudget >= 0 &&
        data.missionOffering is number && data.missionOffering >= 0 &&
        data.localChurchOffering is number && data.localChurchOffering >= 0 &&
        data.specialOffering is number && data.specialOffering >= 0 &&
        data.totalIncome is number && data.totalIncome >= 0 &&
        data.totalExpense is number && data.totalExpense >= 0 &&
        data.status in ['draft', 'submitted', 'verified'] &&
        validOptStr(data, 'notes', 2000) &&
        validOptStr(data, 'famId', 128) &&
        (!('history' in data) || (data.history is list && data.history.size() <= 100 && (data.history.size() == 0 || data.history[0] is map))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Canonical Flutter church report. FAM data and legacy React records use their existing rules.
    function canonicalFinancialKeys() {
      return ['id', 'churchId', 'missionId', 'districtId', 'regionId', 'month', 'year',
        'tithe', 'offerings', 'specialOfferings', 'receiptNumberFrom', 'receiptNumberTo',
        'customFinanceTypes', 'notes', 'submittedBy', 'submittedAt', 'createdAt',
        'updatedAt', 'editedBy', 'status', 'history'];
    }

    function validCanonicalFinancial(data, reportId) {
      return data.id == reportId && isValidId(data.churchId) && isValidId(data.missionId) && isValidId(data.districtId) &&
        data.month is timestamp && data.year is int && data.year >= 2000 && data.year <= 2100 &&
        data.tithe is number && data.tithe >= 0 && data.offerings is number && data.offerings >= 0 &&
        data.specialOfferings is number && data.specialOfferings >= 0 &&
        data.customFinanceTypes is list && data.customFinanceTypes.size() <= 30 &&
        data.history is list && data.history.size() <= 100 &&
        data.notes is string && data.notes.size() <= 2000 &&
        data.receiptNumberFrom is string && data.receiptNumberFrom.size() <= 120 &&
        data.receiptNumberTo is string && data.receiptNumberTo.size() <= 120 &&
        data.status in ['draft', 'submitted'] && isValidId(data.submittedBy) && data.editedBy == request.auth.uid &&
        data.createdAt is timestamp && data.submittedAt is timestamp && data.updatedAt == request.time;
    }

    function churchMatchesFinancial(data) {
      let church = get(/databases/$(database)/documents/churches/$(data.churchId)).data;
      return church.missionId == data.missionId && church.districtId == data.districtId;
    }

    function isDistrictFinancialReader(data) {
      return isAdmin() || isMissionAdmin() || (
        hasRole(callerDoc(), ['district_pastor', 'districtPastor']) && isValidId(callerDistrictId()) && (
          data.get('districtId', '') == callerDistrictId() ||
          (isValidId(data.get('churchId', '')) && get(/databases/$(database)/documents/churches/$(data.churchId)).data.districtId == callerDistrictId())
        )
      );
    }

    function isValidFamData(data) {
      return data.keys().hasAll(['reportId', 'missionId', 'districtId', 'churchId', 'submittedBy', 'year', 'month', 'openingBalance', 'closingBalance', 'funds', 'expenses', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['reportId', 'missionId', 'districtId', 'churchId', 'submittedBy', 'year', 'month', 'openingBalance', 'closingBalance', 'funds', 'expenses', 'createdAt', 'updatedAt']) &&
        isValidId(data.reportId) &&
        isValidId(data.missionId) &&
        isValidId(data.districtId) &&
        isValidId(data.churchId) &&
        isValidId(data.submittedBy) &&
        data.year is int && data.year >= 2000 && data.year <= 2100 &&
        data.month is int && data.month >= 1 && data.month <= 12 &&
        data.openingBalance is number &&
        data.closingBalance is number &&
        data.funds is list && data.funds.size() <= 50 && (data.funds.size() == 0 || data.funds[0] is map) &&
        data.expenses is list && data.expenses.size() <= 50 && (data.expenses.size() == 0 || data.expenses[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuarterlyReport(data) {
      return data.keys().hasAll(['missionId', 'regionId', 'districtId', 'churchId', 'churchName', 'department', 'year', 'quarter', 'submittedBy', 'status', 'payload', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'regionId', 'districtId', 'churchId', 'churchName', 'districtName', 'department', 'year', 'quarter', 'submittedBy', 'submittedByName', 'status', 'payload', 'notes', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        isValidId(data.regionId) &&
        isValidId(data.districtId) &&
        isValidId(data.churchId) &&
        data.churchName is string && data.churchName.size() >= 1 && data.churchName.size() <= 160 &&
        validOptStr(data, 'districtName', 120) &&
        data.department in ['kanak_kanak', 'penatalayanan', 'sspm', 'wanita'] &&
        data.year is int && data.year >= 2000 && data.year <= 2100 &&
        data.quarter is int && data.quarter >= 1 && data.quarter <= 4 &&
        isValidId(data.submittedBy) &&
        validOptStr(data, 'submittedByName', 120) &&
        data.status in ['draft', 'submitted'] &&
        data.payload is map && data.payload.keys().size() <= 40 &&
        validOptStr(data, 'notes', 2000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function borangBKeys() {
      return [
        'id', 'userId', 'userName', 'pastorName', 'missionId', 'regionId', 'districtId',
        'districtName', 'churchId', 'year', 'month', 'status', 'submittedAt', 'membersBeginning',
        'membersReceived', 'membersTransferredIn', 'membersTransferredOut', 'membersDropped', 'membersDeceased', 'membersEnd', 'baptisms',
        'professionOfFaith', 'sabbathServices', 'prayerMeetings', 'bibleStudies', 'evangelisticMeetings', 'homeVisitations', 'hospitalVisitations',
        'prisonVisitations', 'weddings', 'funerals', 'dedications', 'booksDistributed', 'magazinesDistributed', 'tractsDistributed',
        'tithe', 'offerings', 'otherActivities', 'challenges', 'remarks', 'sermonsPreached', 'bibleStudiesGiven',
        'counselingSessions', 'professionsOfFaith', 'boardMeetings', 'communionServices', 'anointings', 'childDedications', 'titheFaithfulnessNotes',
        'challengesAndPrayer', 'nextMonthGoals', 'createdAt', 'updatedAt'
      ];
    }

    function isValidBorangB(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'month', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) && isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.month is string && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])-01T.*$') &&
        data.status in ['draft', 'submitted'] &&
        (data.get('missionId', '') is string) && (data.get('districtId', '') is string) &&
        (data.get('regionId', '') is string) && (data.get('districtName', '') is string) &&
        (data.get('churchId', '') is string) &&
        (data.membersBeginning is int && data.membersBeginning >= 0) &&
        (data.membersReceived is int && data.membersReceived >= 0) &&
        (data.membersTransferredIn is int && data.membersTransferredIn >= 0) &&
        (data.membersTransferredOut is int && data.membersTransferredOut >= 0) &&
        (data.membersDropped is int && data.membersDropped >= 0) &&
        (data.membersDeceased is int && data.membersDeceased >= 0) &&
        (data.membersEnd is int && data.membersEnd >= 0) &&
        (data.baptisms is int && data.baptisms >= 0) &&
        (data.professionOfFaith is int && data.professionOfFaith >= 0) &&
        (data.sabbathServices is int && data.sabbathServices >= 0) &&
        (data.prayerMeetings is int && data.prayerMeetings >= 0) &&
        (data.bibleStudies is int && data.bibleStudies >= 0) &&
        (data.evangelisticMeetings is int && data.evangelisticMeetings >= 0) &&
        (data.homeVisitations is int && data.homeVisitations >= 0) &&
        (data.hospitalVisitations is int && data.hospitalVisitations >= 0) &&
        (data.prisonVisitations is int && data.prisonVisitations >= 0) &&
        (data.weddings is int && data.weddings >= 0) &&
        (data.funerals is int && data.funerals >= 0) &&
        (data.dedications is int && data.dedications >= 0) &&
        (data.booksDistributed is int && data.booksDistributed >= 0) &&
        (data.magazinesDistributed is int && data.magazinesDistributed >= 0) &&
        (data.tractsDistributed is int && data.tractsDistributed >= 0) &&

        (!('tithe' in data) || (data.tithe is number && data.tithe >= 0 && data.tithe <= 100000000000)) &&
        (!('offerings' in data) || (data.offerings is number && data.offerings >= 0 && data.offerings <= 100000000000)) &&
        data.otherActivities is string && data.otherActivities.size() <= 10000 && data.challenges is string && data.challenges.size() <= 10000 && data.remarks is string && data.remarks.size() <= 10000 &&
        data.createdAt is string && data.createdAt.size() >= 19 && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() >= 19 && data.updatedAt.size() <= 40;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['userId', 'date', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'missionId', 'districtId', 'churchId', 'churchName',
          'activities', 'mileage', 'note', 'title', 'category', 'date', 'durationMinutes',
          'participants', 'location', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        validOptStr(data, 'id', 128) && validOptStr(data, 'missionId', 128) &&
        validOptStr(data, 'districtId', 128) && validOptStr(data, 'churchId', 128) &&
        validOptStr(data, 'churchName', 160) &&
        (('activities' in data && data.activities is string && data.activities.size() >= 1 && data.activities.size() <= 10000) ||
         ('title' in data && data.title is string && data.title.size() >= 1 && data.title.size() <= 10000)) &&
        (!('mileage' in data) || (data.mileage is number && data.mileage >= 0 && data.mileage <= 1000000)) &&
        (!('category' in data) || data.category in ['visitation', 'evangelism', 'meeting', 'worship', 'counseling', 'training', 'administration']) &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 32 &&
        validOptInt(data, 'durationMinutes', 0, 10080) && validOptInt(data, 'participants', 0, 50000) &&
        (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 160)) &&
        validOptStr(data, 'note', 2000) && validOptStr(data, 'notes', 2000) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['userId', 'title', 'contactName', 'dateTime', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'title', 'contactName', 'contactPhone', 'location', 'dateTime', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 120 &&
        validOptStr(data, 'contactPhone', 40) &&
        validOptStr(data, 'location', 160) &&
        data.dateTime is string && data.dateTime.size() >= 8 && data.dateTime.size() <= 40 &&
        data.status in ['scheduled', 'completed', 'cancelled'] &&
        validOptStr(data, 'notes', 1500) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTodo(data) {
      return data.keys().hasAll(['userId', 'title', 'priority', 'completed', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'title', 'priority', 'dueDate', 'completed', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.priority in ['low', 'medium', 'high'] &&
        validOptStr(data, 'dueDate', 32) &&
        data.completed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['userId', 'title', 'category', 'startDate', 'endDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'missionId', 'districtId', 'title', 'category', 'startDate', 'endDate', 'location', 'description', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        validOptStr(data, 'missionId', 128) &&
        validOptStr(data, 'districtId', 128) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 40 &&
        data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 40 &&
        validOptStr(data, 'location', 160) &&
        validOptStr(data, 'description', 2000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGlobalEvent(data) {
      return data.keys().hasAll(['missionId', 'title', 'category', 'startDate', 'endDate', 'isActive', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'title', 'category', 'startDate', 'endDate', 'location', 'description', 'isSpecialEvent', 'isActive', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 40 &&
        data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 40 &&
        validOptStr(data, 'location', 160) &&
        validOptStr(data, 'description', 2000) &&
        validOptBool(data, 'isSpecialEvent') &&
        data.isActive is bool &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidResource(data) {
      return data.keys().hasAll(['missionId', 'title', 'category', 'url', 'isActive', 'uploadedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['missionId', 'title', 'category', 'description', 'url', 'fileType', 'isActive', 'uploadedBy', 'userId', 'createdAt', 'updatedAt']) &&
        isValidId(data.missionId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        validOptStr(data, 'description', 1000) &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 500 &&
        validOptStr(data, 'fileType', 32) &&
        data.isActive is bool &&
        isValidId(data.uploadedBy) &&
        (!('userId' in data) || data.userId == data.uploadedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLocationRequest(data) {
      return data.keys().hasAll(['userId', 'userName', 'userEmail', 'churchName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'requestedBy', 'userName', 'userEmail', 'missionId', 'missionName', 'regionName', 'districtName', 'churchName', 'notes', 'status', 'reviewedBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        (!('requestedBy' in data) || data.requestedBy == data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
        validOptStr(data, 'missionId', 'missionName', 120) &&
        validOptStr(data, 'regionName', 120) &&
        validOptStr(data, 'districtName', 120) &&
        data.churchName is string && data.churchName.size() >= 1 && data.churchName.size() <= 160 &&
        validOptStr(data, 'notes', 1000) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        validOptStr(data, 'reviewedBy', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['key', 'updatedAt']) &&
        data.keys().hasOnly(['key', 'allowedDomains', 'appVersion', 'maintenanceMode', 'updatedBy', 'updatedAt']) &&
        data.key is string && data.key.size() >= 1 && data.key.size() <= 80 &&
        (!('allowedDomains' in data) || (data.allowedDomains is list && data.allowedDomains.size() <= 50 && (data.allowedDomains.size() == 0 || data.allowedDomains[0] is string))) &&
        validOptStr(data, 'appVersion', 32) &&
        validOptBool(data, 'maintenanceMode') &&
        validOptStr(data, 'updatedBy', 128) &&
        data.updatedAt is timestamp;
    }

    function isValidMinistryTeamMember(data) {
      return data.keys().hasAll(['userId', 'missionId', 'fullName', 'role', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'userId', 'missionId', 'districtId', 'churchId', 'churchName',
          'fullName', 'role', 'phone', 'email', 'notes', 'isActive',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isValidId(data.missionId) &&
        validOptStr(data, 'districtId', 128) &&
        validOptStr(data, 'churchId', 128) &&
        validOptStr(data, 'churchName', 160) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 80 &&
        validOptStr(data, 'phone', 40) &&
        validOptStr(data, 'email', 200) &&
        validOptStr(data, 'notes', 1000) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminActivity(data) {
      return data.keys().hasAll(['actorId', 'actorName', 'action', 'targetType', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['actorId', 'actorName', 'action', 'targetType', 'targetId', 'summary', 'missionId', 'createdAt']) &&
        isValidId(data.actorId) &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 64 &&
        validOptStr(data, 'targetId', 128) &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // Test connection doc
    match /test/{docId} {
      allow get: if isValidId(docId) && isSignedIn();
    }

    // Users (PII Isolation + Strict Anti-Self-Elevation)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || canManageUser(existing()));
      allow list: if isSignedIn() && (existing().get('uid', '') == request.auth.uid || canManageUser(existing()));
      allow create: if isValidId(userId) && isVerified() &&
        isValidUser(incoming()) &&
        incoming().keys().hasAll(['uid', 'level', 'isActive', 'createdAt', 'updatedAt']) &&
        incoming().uid == request.auth.uid &&
        request.auth.uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isBootstrappedSuperAdmin() || (
            incoming().userRole == 'user' &&
            incoming().get('role', 'user') == 'user' &&
            incoming().get('roleTitle', 'Pastor / User') in ['Pastor / User', 'User'] &&
            incoming().email == request.auth.token.email &&
            incoming().level == 1 &&
            incoming().get('isAdmin', false) == false &&
            incoming().get('isPremium', false) == false &&
            incoming().isActive == false &&
            incoming().get('approvalStatus', 'pending') == 'pending'
          )
        );
      allow update: if isValidId(userId) && isVerified() &&
        canUpdateUser(userId, existing(), incoming()) &&
        isValidUser(incoming()) &&
        incoming().get('uid', userId) == existing().get('uid', userId) &&
        incoming().get('createdAt', null) == existing().get('createdAt', null) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isSuperAdmin() && request.auth.uid != userId;
    }

    // Unions
    match /unions/{unionId} {
      allow get: if isValidId(unionId) && isSignedIn();
      allow list: if isSignedIn() && existing().name is string;
      allow create: if isValidId(unionId) && isAdmin() && isValidUnion(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(unionId) && isAdmin() && isValidUnion(incoming()) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(unionId) && isSuperAdmin();
    }

    // Missions & subcollections
    match /missions/{missionId} {
      allow get: if isValidId(missionId) && isSignedIn();
      allow list: if isSignedIn() && existing().name is string;
      allow create: if isValidId(missionId) && isAdmin() && isValidMission(incoming()) &&
        (!('unionId' in incoming()) || incoming().unionId == '' || exists(/databases/$(database)/documents/unions/$(incoming().unionId))) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(missionId) && isAdmin() && isValidMission(incoming()) &&
        (!('unionId' in incoming()) || incoming().unionId == '' || exists(/databases/$(database)/documents/unions/$(incoming().unionId))) &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(missionId) && isSuperAdmin();

      match /departments/{departmentId} {
        allow get: if isValidId(missionId) && isValidId(departmentId) && isSignedIn();
        allow list: if isValidId(missionId) && isSignedIn() && existing().missionId == missionId;
        allow create: if isValidId(missionId) && isValidId(departmentId) && isMissionAdminFor(missionId) &&
          isValidDepartment(incoming()) && incoming().missionId == missionId &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isValidId(missionId) && isValidId(departmentId) && isMissionAdminFor(missionId) &&
          isValidDepartment(incoming()) && incoming().missionId == existing().missionId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
        allow delete: if isValidId(missionId) && isValidId(departmentId) && isAdmin();
      }

      match /reports/{reportId} {
        allow get: if isValidId(missionId) && isValidId(reportId) && isMissionLeadershipFor(missionId);
        allow list: if isValidId(missionId) && isMissionLeadershipFor(missionId) && existing().missionId == missionId;
        allow create: if isValidId(missionId) && isValidId(reportId) && isMissionAdminFor(missionId) &&
          isValidMissionReportSummary(incoming()) &&
          incoming().missionId == missionId && incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isValidId(missionId) && isValidId(reportId) && isMissionAdminFor(missionId) &&
          isValidMissionReportSummary(incoming()) &&
          incoming().missionId == existing().missionId && incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isValidId(missionId) && isValidId(reportId) && isAdmin();
      }
    }

    // Regions
    match /regions/{regionId} {
      allow get: if isValidId(regionId) && isSignedIn();
      allow list: if isSignedIn() && existing().missionId is string;
      allow create: if isValidId(regionId) && isValidRegion(incoming()) && isMissionAdminFor(incoming().missionId) &&
        exists(/databases/$(database)/documents/missions/$(incoming().missionId)) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(regionId) && isValidRegion(incoming()) && isMissionAdminFor(existing().missionId) &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(regionId) && isAdmin();
    }

    // Districts
    match /districts/{districtId} {
      allow get: if isValidId(districtId) && isSignedIn();
      allow list: if isSignedIn() && existing().missionId is string;
      allow create: if isValidId(districtId) && isValidDistrict(incoming()) && isMissionAdminFor(incoming().missionId) &&
        exists(/databases/$(database)/documents/regions/$(incoming().regionId)) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(districtId) && isValidDistrict(incoming()) && isMissionAdminFor(existing().missionId) &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(districtId) && isAdmin();
    }

    // Churches
    match /churches/{churchId} {
      allow get: if isValidId(churchId) && isSignedIn();
      allow list: if isSignedIn() && existing().districtId is string;
      allow create: if isValidId(churchId) && isValidChurch(incoming()) && isMissionAdminFor(incoming().missionId) &&
        exists(/databases/$(database)/documents/districts/$(incoming().districtId)) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(churchId) && isValidChurch(incoming()) && isMissionAdminFor(existing().missionId) &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(churchId) && isAdmin();
    }

    // Staff Directory
    match /staff/{staffId} {
      allow get: if isValidId(staffId) && isSignedIn();
      allow list: if isSignedIn() && existing().missionId is string;
      allow create: if isValidId(staffId) && isValidStaff(incoming()) && isMissionAdminFor(incoming().missionId) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(staffId) && isValidStaff(incoming()) && isMissionAdminFor(existing().missionId) &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(staffId) && isAdmin();
    }

    // Departments Directory
    match /departments/{departmentId} {
      allow get: if isValidId(departmentId) && isSignedIn();
      allow list: if isSignedIn() && existing().missionId is string;
      allow create: if isValidId(departmentId) && isValidDepartment(incoming()) && isEditorInMission(incoming().missionId) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(departmentId) && isValidDepartment(incoming()) && isEditorInMission(existing().missionId) &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(departmentId) && isAdmin();
    }

    // Financial Reports (Church Treasurer + Mission Leadership)
    match /financial_reports/{reportId} {
      allow read: if isActiveUser() && isDistrictFinancialReader(existing());
      allow create: if isActiveUser() && isValidId(reportId) && validCanonicalFinancial(incoming(), reportId) &&
        incoming().keys().hasOnly(canonicalFinancialKeys()) && incoming().submittedBy == request.auth.uid &&
        incoming().createdAt == request.time && churchMatchesFinancial(incoming()) &&
        (isMissionAdminFor(incoming().missionId) || isDistrictPastorFor(incoming().districtId) || isChurchTreasurerFor(incoming().churchId));
      allow update: if isActiveUser() && isValidId(reportId) && validCanonicalFinancial(incoming(), reportId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(canonicalFinancialKeys()) && existing().month is timestamp &&
        incoming().churchId == existing().churchId && incoming().missionId == existing().missionId &&
        incoming().districtId == existing().districtId && incoming().month == existing().month && incoming().year == existing().year &&
        incoming().createdAt == existing().createdAt && incoming().submittedBy == existing().submittedBy &&
        !(existing().status in ['approved', 'verified']) && churchMatchesFinancial(incoming()) &&
        (isMissionAdminFor(existing().missionId) || isDistrictPastorFor(existing().districtId) || isChurchTreasurerFor(existing().churchId));
      allow get: if isValidId(reportId) && isActiveUser() && (
        isAdmin() ||
        existing().submittedBy == request.auth.uid ||
        isChurchTreasurerFor(existing().churchId) ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow list: if isActiveUser() && (
        isAdmin() ||
        existing().submittedBy == request.auth.uid ||
        (hasRole(callerDoc(), ['church_treasurer', 'churchTreasurer']) && existing().churchId == callerDoc().get('churchId', '')) ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow create: if isValidId(reportId) && isActiveUser() &&
        isValidFinancialReport(incoming()) &&
        incoming().submittedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/churches/$(incoming().churchId)) && (
          isMissionAdminFor(incoming().missionId) ||
          isChurchTreasurerFor(incoming().churchId)
        );
      allow update: if isValidId(reportId) && isActiveUser() &&
        isValidFinancialReport(incoming()) &&
        incoming().churchId == existing().churchId &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isMissionAdminFor(existing().missionId) ||
          (
            isChurchTreasurerFor(existing().churchId) &&
            existing().status != 'verified' &&
            incoming().status in ['draft', 'submitted']
          )
        );
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // FAM Data (1:1 linked to Financial Report)
    match /fam_data/{famId} {
      allow get: if isValidId(famId) && isActiveUser() && (
        existing().submittedBy == request.auth.uid ||
        isChurchTreasurerFor(existing().churchId) ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow list: if isActiveUser() && (
        existing().submittedBy == request.auth.uid ||
        (hasRole(callerDoc(), ['church_treasurer', 'churchTreasurer']) && existing().churchId == callerDoc().get('churchId', '')) ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow create: if isValidId(famId) && isActiveUser() &&
        isValidFamData(incoming()) &&
        incoming().submittedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isMissionAdminFor(incoming().missionId) ||
          isChurchTreasurerFor(incoming().churchId)
        );
      allow update: if isValidId(famId) && isActiveUser() &&
        isValidFamData(incoming()) &&
        incoming().reportId == existing().reportId &&
        incoming().churchId == existing().churchId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isMissionAdminFor(existing().missionId) ||
          isChurchTreasurerFor(existing().churchId)
        );
      allow delete: if isValidId(famId) && isAdmin();
    }

    function validDepartmentTemplate(data) {
      return data.keys().hasAll(['key', 'name', 'isActive', 'order', 'steps', 'createdAt', 'updatedAt', 'createdBy']) &&
        data.keys().hasOnly(['key', 'name', 'description', 'isActive', 'order', 'steps', 'createdAt', 'updatedAt', 'createdBy']) &&
        data.key is string && data.key.matches('^[a-z][a-z0-9_]{0,63}$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        validOptStr(data, 'description', 4000) && data.isActive is bool && data.order is number &&
        data.steps is list && data.steps.size() > 0 && data.steps.size() <= 20 &&
        data.createdAt is timestamp && data.updatedAt is timestamp && isValidId(data.createdBy);
    }
    match /department_report_templates/{templateId} {
      allow read: if isActiveUser();
      allow create: if isAdmin() && isValidId(templateId) && validDepartmentTemplate(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isAdmin() && validDepartmentTemplate(incoming()) && incoming().key == existing().key &&
        incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin();
    }
    function dynamicDepartmentKeys() {
      return ['id', 'churchId', 'churchName', 'districtId', 'missionId', 'year', 'quarter', 'templateId',
        'departmentKey', 'departmentName', 'submittedBy', 'submittedByName', 'submittedAt', 'createdAt',
        'updatedAt', 'editedBy', 'values', 'templateSnapshot', 'templateRevision', 'templateUpdatedAt', 'status'];
    }
    function validDynamicDepartment(data, reportId) {
      let template = get(/databases/$(database)/documents/department_report_templates/$(data.templateId)).data;
      return data.id == reportId && isValidId(data.churchId) && isValidId(data.districtId) && isValidId(data.missionId) &&
        data.churchName is string && data.churchName.size() > 0 && data.churchName.size() <= 160 &&
        data.year is int && data.year >= 2000 && data.year <= 2100 && data.quarter in [1, 2, 3, 4] &&
        data.departmentKey == template.key && data.departmentName is string && data.departmentName.size() <= 160 && template.isActive == true &&
        data.values is map && data.values.size() <= 800 && data.submittedBy is string && data.submittedByName is string &&
        data.createdAt is timestamp && data.submittedAt is timestamp && data.updatedAt is timestamp && data.editedBy == request.auth.uid &&
        (!('templateSnapshot' in data) || (data.templateSnapshot is map && data.templateSnapshot.key == template.key)) &&
        (!('templateUpdatedAt' in data) || data.templateUpdatedAt == template.updatedAt);
    }

    // Quarterly Department Reports (Deterministic ID: {churchId}_{year}_Q{quarter}_{department})
    match /quarterly_department_reports/{reportId} {
      allow read: if isActiveUser() && isDistrictFinancialReader(existing());
      allow create: if isActiveUser() && isValidId(reportId) && validDynamicDepartment(incoming(), reportId) &&
        incoming().keys().hasOnly(dynamicDepartmentKeys()) && incoming().submittedBy == request.auth.uid &&
        churchMatchesFinancial(incoming()) && (isAdmin() || isDistrictPastorFor(incoming().districtId));
      allow update: if isActiveUser() && isValidId(reportId) && validDynamicDepartment(incoming(), reportId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(dynamicDepartmentKeys()) &&
        incoming().churchId == existing().churchId && incoming().missionId == existing().missionId && incoming().districtId == existing().districtId &&
        incoming().year == existing().year && incoming().quarter == existing().quarter &&
        incoming().submittedBy == existing().submittedBy && incoming().createdAt == existing().createdAt &&
        ((!('departmentKey' in existing()) &&
          (incoming().departmentKey == existing().get('department', '') || (incoming().departmentKey == 'kanak_kanak' && existing().get('department', '') == 'kanakKanak'))) || incoming().departmentKey == existing().get('departmentKey', '')) &&
        churchMatchesFinancial(incoming()) && (isAdmin() || isDistrictPastorFor(incoming().districtId));

      allow get: if isValidId(reportId) && isActiveUser() && (
        isAdmin() ||
        existing().submittedBy == request.auth.uid ||
        isDistrictPastorFor(existing().districtId) ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow list: if isActiveUser() && (
        isAdmin() ||
        existing().submittedBy == request.auth.uid ||
        (hasRole(callerDoc(), ['district_pastor', 'districtPastor']) && existing().districtId == callerDistrictId()) ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow create: if isValidId(reportId) && isActiveUser() &&
        isValidQuarterlyReport(incoming()) &&
        incoming().submittedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/churches/$(incoming().churchId)) && (
          isMissionAdminFor(incoming().missionId) ||
          isDistrictPastorFor(incoming().districtId)
        );
      allow update: if isValidId(reportId) && isActiveUser() &&
        isValidQuarterlyReport(incoming()) &&
        incoming().churchId == existing().churchId &&
        incoming().missionId == existing().missionId &&
        incoming().districtId == existing().districtId &&
        incoming().submittedBy == existing().submittedBy &&
        incoming().department == existing().department &&
        incoming().year == existing().year &&
        incoming().quarter == existing().quarter &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isMissionAdminFor(existing().missionId) ||
          isDistrictPastorFor(existing().districtId)
        );
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // Borang B Monthly Pastoral Reports
    match /borang_b_reports/{reportId} {
      allow read: if isActiveUser() && hasRole(callerDoc(), ['district_pastor', 'districtPastor']) && isValidId(callerDistrictId()) && existing().get('districtId', '') == callerDistrictId();
      allow get: if isValidId(reportId) && isActiveUser() && (
        existing().userId == request.auth.uid ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow list: if isActiveUser() && (
        existing().userId == request.auth.uid ||
        isMissionLeadershipFor(existing().get('missionId', ''))
      );
      allow create: if isValidId(reportId) && isActiveUser() &&
        isValidBorangB(incoming()) && incoming().keys().hasOnly(borangBKeys()) &&
        incoming().id == reportId && incoming().userId == request.auth.uid;
      allow update: if isValidId(reportId) && isActiveUser() &&
        isValidBorangB(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(borangBKeys()) &&
        incoming().id == reportId && incoming().userId == existing().userId &&
        (incoming().createdAt == existing().createdAt || (existing().month is int && existing().createdAt is timestamp)) && (
          existing().userId == request.auth.uid ||
          isAdmin()
        );
      allow delete: if isValidId(reportId) && isActiveUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // Pastoral Activities
    match /activities/{activityId} {
      allow get: if isValidId(activityId) && isActiveUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isActiveUser() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(activityId) && isActiveUser() &&
        isValidActivity(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(activityId) && isActiveUser() &&
        isValidActivity(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          existing().userId == request.auth.uid || isAdmin()
        );
      allow delete: if isValidId(activityId) && isActiveUser() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // Pastoral Appointments
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && isActiveUser() && existing().userId == request.auth.uid;
      allow list: if isActiveUser() && existing().userId == request.auth.uid;
      allow create: if isValidId(appointmentId) && isActiveUser() &&
        isValidAppointment(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(appointmentId) && isActiveUser() &&
        isValidAppointment(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().userId == request.auth.uid;
      allow delete: if isValidId(appointmentId) && isActiveUser() && existing().userId == request.auth.uid;
    }

    // Ministry Team & Church Elders
    match /ministry_team/{memberId} {
      allow get: if isValidId(memberId) && isActiveUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isActiveUser() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isValidId(memberId) && isActiveUser() &&
        isValidMinistryTeamMember(incoming()) &&
        incoming().userId == request.auth.uid &&
        exists(/databases/$(database)/documents/missions/$(incoming().missionId)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(memberId) && isActiveUser() &&
        isValidMinistryTeamMember(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isValidId(memberId) && isActiveUser() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Personal To-Dos
    match /todos/{todoId} {
      allow get: if isValidId(todoId) && isActiveUser() && existing().userId == request.auth.uid;
      allow list: if isActiveUser() && existing().userId == request.auth.uid;
      allow create: if isValidId(todoId) && isActiveUser() &&
        isValidTodo(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(todoId) && isActiveUser() &&
        isValidTodo(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().userId == request.auth.uid;
      allow delete: if isValidId(todoId) && isActiveUser() && existing().userId == request.auth.uid;
    }

    // Personal / Local Events
    match /events/{eventId} {
      allow get: if isValidId(eventId) && isActiveUser() && existing().userId == request.auth.uid;
      allow list: if isActiveUser() && existing().userId == request.auth.uid;
      allow create: if isValidId(eventId) && isActiveUser() &&
        isValidEvent(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(eventId) && isActiveUser() &&
        isValidEvent(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().userId == request.auth.uid;
      allow delete: if isValidId(eventId) && isActiveUser() && existing().userId == request.auth.uid;
    }

    // Mission-Wide Global Events
    match /global_events/{eventId} {
      allow get: if isValidId(eventId) && isActiveUser() && (isAdmin() || existing().missionId == callerMissionId());
      allow list: if isActiveUser() && (isAdmin() || existing().missionId == callerMissionId());
      allow create: if isValidId(eventId) && isValidGlobalEvent(incoming()) &&
        isEditorInMission(incoming().missionId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(eventId) && isValidGlobalEvent(incoming()) &&
        isEditorInMission(existing().missionId) &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(eventId) && isAdmin();
    }

    // Shared Resources
    match /resources/{resourceId} {
      allow get: if isValidId(resourceId) && isActiveUser() && (isAdmin() || existing().missionId == callerMissionId());
      allow list: if isActiveUser() && (isAdmin() || existing().missionId == callerMissionId());
      allow create: if isValidId(resourceId) && isValidResource(incoming()) &&
        isEditorInMission(incoming().missionId) &&
        incoming().uploadedBy == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(resourceId) && isValidResource(incoming()) &&
        isEditorInMission(existing().missionId) &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(resourceId) && isAdmin();
    }

    // Onboarding Location Requests
    match /locationRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (existing().userId == request.auth.uid || isMissionAdminFor(existing().get('missionId', '')));
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isMissionAdminFor(existing().get('missionId', '')));
      allow create: if isValidId(requestId) && isVerified() &&
        isValidLocationRequest(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(requestId) && isMissionAdminFor(existing().get('missionId', '')) &&
        isValidLocationRequest(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().get('missionId', '') == existing().get('missionId', '') &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // App Settings
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn() && existing().key is string;
      allow create: if isValidId(settingId) && isAdmin() && isValidSetting(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin() && isValidSetting(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isSuperAdmin();
    }

    // Admin Activity Audit Log (Append-only)
    match /admin_activity/{activityId} {
      allow get: if isValidId(activityId) && isMissionAdminFor(existing().get('missionId', ''));
      allow list: if isMissionAdminFor(existing().get('missionId', ''));
      allow create: if isValidId(activityId) && isMissionAdminFor(incoming().get('missionId', '')) &&
        isValidAdminActivity(incoming()) &&
        incoming().actorId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
