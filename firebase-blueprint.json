{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated platform user with role, capability level, and hierarchical mission/region/district/church assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 40 },
        "userRole": {
          "type": "string",
          "enum": [
            "super_admin",
            "admin",
            "mission_admin",
            "ministerial_secretary",
            "director",
            "officer",
            "editor",
            "district_pastor",
            "church_treasurer",
            "user"
          ]
        },
        "role": { "type": "string", "maxLength": 64 },
        "roleTitle": { "type": "string", "maxLength": 80 },
        "isAdmin": { "type": "boolean" },
        "level": { "type": "integer" },
        "unionId": { "type": "string", "maxLength": 128 },
        "unionName": { "type": "string", "maxLength": 120 },
        "missionId": { "type": "string", "maxLength": 128 },
        "missionName": { "type": "string", "maxLength": 120 },
        "regionId": { "type": "string", "maxLength": 128 },
        "regionName": { "type": "string", "maxLength": 120 },
        "districtId": { "type": "string", "maxLength": 128 },
        "districtName": { "type": "string", "maxLength": 120 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 120 },
        "isPremium": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvalNote": { "type": "string", "maxLength": 300 },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "userRole", "level", "isActive", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "Union": {
      "title": "Union",
      "description": "Top-level Adventist Union entity (e.g., Malaysia Union Mission) overseeing Missions.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "code": { "type": "string", "minLength": 1, "maxLength": 24 },
        "country": { "type": "string", "maxLength": 80 },
        "headquarters": { "type": "string", "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "isActive", "createdAt", "updatedAt"]
    },
    "Mission": {
      "title": "Mission",
      "description": "Adventist Mission entity (e.g., Sabah Adventist Mission) belonging to a Union.",
      "type": "object",
      "properties": {
        "unionId": { "type": "string", "maxLength": 128 },
        "unionName": { "type": "string", "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "code": { "type": "string", "minLength": 1, "maxLength": 24 },
        "country": { "type": "string", "maxLength": 80 },
        "headquarters": { "type": "string", "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "isActive", "createdAt", "updatedAt"]
    },
    "MissionDepartment": {
      "title": "MissionDepartment",
      "description": "Department scoped under a specific mission.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "directorName": { "type": "string", "maxLength": 120 },
        "resourceUrl": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "name", "isActive", "createdAt", "updatedAt"]
    },
    "MissionReportSummary": {
      "title": "MissionReportSummary",
      "description": "Aggregated mission-level report snapshot.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "period": { "type": "string", "maxLength": 32 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "title", "period", "createdBy", "createdAt", "updatedAt"]
    },
    "Region": {
      "title": "Region",
      "description": "Administrative region under a mission.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "code": { "type": "string", "maxLength": 24 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "name", "isActive", "createdAt", "updatedAt"]
    },
    "District": {
      "title": "District",
      "description": "Pastoral district under a region and mission.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "regionId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "districtPastorId": { "type": "string", "maxLength": 128 },
        "districtPastorName": { "type": "string", "maxLength": 120 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "regionId", "name", "isActive", "createdAt", "updatedAt"]
    },
    "Church": {
      "title": "Church",
      "description": "Local church belonging to a district, region, and mission.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "regionId": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "churchCode": { "type": "string", "maxLength": 32 },
        "treasurerId": { "type": "string", "maxLength": 128 },
        "treasurerName": { "type": "string", "maxLength": 120 },
        "memberCount": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "regionId", "districtId", "name", "isActive", "createdAt", "updatedAt"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Mission staff directory entry assignable to districts.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "regionId": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "position": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "inactive", "transferred"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "fullName", "position", "status", "isActive", "createdAt", "updatedAt"]
    },
    "Department": {
      "title": "Department",
      "description": "Church department directory entry with resource links.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "code": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 600 },
        "directorName": { "type": "string", "maxLength": 120 },
        "resourceUrl": { "type": "string", "maxLength": 500 },
        "secondaryUrl": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "name", "isActive", "createdAt", "updatedAt"]
    },
    "FinancialReport": {
      "title": "FinancialReport",
      "description": "Monthly church tithe and offering report with edit history.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "regionId": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 128 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 160 },
        "submittedBy": { "type": "string", "maxLength": 128 },
        "submittedByName": { "type": "string", "maxLength": 120 },
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "tithe": { "type": "number" },
        "combinedBudget": { "type": "number" },
        "missionOffering": { "type": "number" },
        "localChurchOffering": { "type": "number" },
        "specialOffering": { "type": "number" },
        "totalIncome": { "type": "number" },
        "totalExpense": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "submitted", "verified"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "famId": { "type": "string", "maxLength": 128 },
        "history": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "missionId", "regionId", "districtId", "churchId", "churchName",
        "submittedBy", "year", "month", "tithe", "combinedBudget",
        "missionOffering", "localChurchOffering", "specialOffering",
        "totalIncome", "totalExpense", "status", "createdAt", "updatedAt"
      ]
    },
    "FamData": {
      "title": "FamData",
      "description": "Financial Accounting Method (FAM) fund-by-fund income and expense breakdown linked 1:1 to a financial report.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 128 },
        "missionId": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 128 },
        "churchId": { "type": "string", "maxLength": 128 },
        "submittedBy": { "type": "string", "maxLength": 128 },
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "openingBalance": { "type": "number" },
        "closingBalance": { "type": "number" },
        "funds": { "type": "array" },
        "expenses": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "missionId", "districtId", "churchId", "submittedBy", "year", "month", "openingBalance", "closingBalance", "funds", "expenses", "createdAt", "updatedAt"]
    },
    "QuarterlyDepartmentReport": {
      "title": "QuarterlyDepartmentReport",
      "description": "Quarterly department submission for Kanak-Kanak, Penatalayanan, SSPM, or Wanita with deterministic ID {churchId}_{year}_Q{quarter}_{department}.",
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "maxLength": 128 },
        "regionId": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 128 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 160 },
        "districtName": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "enum": ["kanak_kanak", "penatalayanan", "sspm", "wanita"] },
        "year": { "type": "integer" },
        "quarter": { "type": "integer" },
        "submittedBy": { "type": "string", "maxLength": 128 },
        "submittedByName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["draft", "submitted"] },
        "payload": { "type": "object" },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "regionId", "districtId", "churchId", "churchName", "department", "year", "quarter", "submittedBy", "status", "payload", "createdAt", "updatedAt"]
    },
    "BorangBReport": {
      "title": "BorangBReport",
      "description": "Monthly ministerial pastoral report (Borang B) with auto-save draft/submitted state.",
      "type": "object",
