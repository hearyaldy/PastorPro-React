        "userId": { "type": "string", "maxLength": 128 },
        "pastorName": { "type": "string", "maxLength": 120 },
        "missionId": { "type": "string", "maxLength": 128 },
        "regionId": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 128 },
        "districtName": { "type": "string", "maxLength": 120 },
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "submitted"] },
        "sermonsPreached": { "type": "integer" },
        "bibleStudiesGiven": { "type": "integer" },
        "homeVisitations": { "type": "integer" },
        "hospitalVisitations": { "type": "integer" },
        "counselingSessions": { "type": "integer" },
        "evangelisticMeetings": { "type": "integer" },
        "baptisms": { "type": "integer" },
        "professionsOfFaith": { "type": "integer" },
        "boardMeetings": { "type": "integer" },
        "communionServices": { "type": "integer" },
        "anointings": { "type": "integer" },
        "weddings": { "type": "integer" },
        "funerals": { "type": "integer" },
        "childDedications": { "type": "integer" },
        "titheFaithfulnessNotes": { "type": "string", "maxLength": 1500 },
        "challengesAndPrayer": { "type": "string", "maxLength": 2000 },
        "nextMonthGoals": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "pastorName", "missionId", "districtId", "year", "month", "status",
        "sermonsPreached", "bibleStudiesGiven", "homeVisitations", "hospitalVisitations",
        "counselingSessions", "evangelisticMeetings", "baptisms", "professionsOfFaith",
        "boardMeetings", "communionServices", "createdAt", "updatedAt"
      ]
    },
    "Activity": {
      "title": "Activity",
      "description": "Pastoral activity log entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "missionId": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 128 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 160 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "enum": ["visitation", "evangelism", "meeting", "worship", "counseling", "training", "administration"] },
